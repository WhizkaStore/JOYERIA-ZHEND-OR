# Configuración de ZHEND'OR Joyería
# Copia este archivo como .env y ajusta los valores. No compartas el .env real.

# Puerto del servidor
PORT=3000

# Usuario o correo del panel de administración (por defecto: admin)
ADMIN_USER=admin

# Contraseña del panel de administración (cámbiala por una segura)
ADMIN_PASSWORD=Cambiar123*

# Duración de la sesión de admin en días
SESSION_DAYS=7

# En producción con HTTPS, activa la cookie de sesión como "Secure"
COOKIE_SECURE=false

# Directorio de datos (opcional). En Render/Railway monta aquí el disco/volumen.
# DATA_DIR=/data

# Directorio de imágenes (opcional). Por defecto vive dentro de DATA_DIR.
# UPLOADS_DIR=/data/uploads
